# =============================================================================
# SmartPark India - Production & Container Environment Variables Template
# Copy this file to .env and configure environment-specific values.
# NEVER commit real credentials or .env to version control.
# =============================================================================

# PostgreSQL Configuration
DB_HOST=postgres
DB_PORT=5433
DB_NAME=smartpark
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Configuration
KAFKA_HOST=localhost
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Security & JWT Configuration
JWT_SECRET=smartpark_default_dev_secret_key_at_least_256_bits_for_hmac_sha256_security!
JWT_EXPIRATION=86400000

# CORS & Web Networking
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://localhost
